{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "outDir": "out",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "rootDir": ".",
        "strict": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "noUnusedParameters": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "types": [
            "node",
            "@microsoft/vscode-azext-eng/mocha/test-globals"
        ],
        "skipLibCheck": true
    },
    "exclude": [
        "**/node_modules",
        ".vscode-test",
        "gulpfile.ts",
        "**/dist",
        "**/out",
        "evals",
        "src/webviews/copilotOnRails/views"
    ]
}
