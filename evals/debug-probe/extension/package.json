{
    "name": "cor-debug-probe",
    "displayName": "Copilot on Rails debug probe",
    "description": "Test-only VS Code extension that verifies a breakpoint can actually be hit in a generated project. Never shipped to users.",
    "publisher": "ms-azuretools",
    "version": "0.1.0",
    "private": true,
    "license": "MIT",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Testing"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/extension.js",
    "contributes": {},
    "scripts": {
        "compile": "tsc -p .",
        "typecheck": "tsc -p . --noEmit",
        "package": "npm run compile && vsce package --out cor-debug-probe.vsix"
    },
    "devDependencies": {
        "@types/node": "22.x",
        "@types/vscode": "^1.90.0",
        "@vscode/vsce": "^3.2.0",
        "typescript": "^5.9.2"
    }
}
