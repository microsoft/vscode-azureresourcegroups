              "type": "tm.Process",
              "name": "Local dev server",
              "description": "Frontend dev server spawned for the Approve-UI preview (devServerManager.ts), embedded in an iframe.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                { "id": "t-devserver-lan", "title": "Dev server reachable on the LAN / DNS rebinding", "status": "Open", "severity": "Medium", "type": "Information disclosure", "description": "The extension runs the generated project's own dev/start script unmodified (devServerManager.ts) and does not set host or allowedHosts, so binding follows the scaffold's framework defaults. Vite and most defaults bind to loopback only; LAN exposure occurs only if a generated dev config binds to 0.0.0.0/all interfaces. The extension normalizes 0.0.0.0/[::] to localhost solely for the webview embed URL, which does not change the actual bind address (so an exposed bind could be masked).", "mitigation": "Mitigation belongs in the scaffold templates: ensure generated dev-server configs bind to loopback and set restrictive allowedHosts so the preview is never LAN-reachable. Scope the webview frame-src to the dev-server URI (FrontendPreviewViewController.ts). These settings must never ship in production config.", "modelType": "STRIDE", "number": 5 }
              ]
            }
