              "hasOpenThreats": true,
              "threats": [
                { "id": "t-xss-preview", "title": "XSS via planner/LLM-generated preview HTML", "status": "Mitigated", "severity": "High", "type": "Tampering", "description": "Generated plan-preview HTML could carry inline scripts that execute in the view.", "mitigation": "Author-supplied executable content is stripped before it reaches the sandboxed srcDoc iframe (previewPagesReader.ts); only a nonce-stamped navigation bridge runs (UiPreviewCard.tsx). CSP is script-src 'nonce-…'.", "modelType": "STRIDE", "number": 1 },
                { "id": "t-inline-script", "title": "Spoofed/injected inline script in webview", "status": "Mitigated", "severity": "Medium", "type": "Tampering", "description": "Injected inline script attempts to run in the webview document.", "mitigation": "Nonce-based CSP; a script without the correct nonce is ignored by the browser.", "modelType": "STRIDE", "number": 2 }
              ]
            }
