              "hasOpenThreats": true,
              "threats": [
                { "id": "t-prompt-injection", "title": "Prompt injection via tool / file content", "status": "Open", "severity": "Medium", "type": "Tampering", "description": "Untrusted content in files or tool output could steer the agent into unintended edits or commands.", "mitigation": "Treat all tool output as untrusted; retain the human approval gates at plan/deploy; least-privilege MCP tool scopes; do not auto-execute destructive actions without confirmation.", "modelType": "STRIDE", "number": 4 }
              ]
