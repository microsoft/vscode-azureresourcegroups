              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "threats": [
                { "id": "t-msg-forge", "title": "Forged / malformed webview→extension message", "status": "Open", "severity": "Medium", "type": "Elevation of privilege", "description": "onDidReceiveMessage handlers switch on a `command` string and act on `data`/`prompt` payloads (e.g. ScaffoldPlanViewController, RequirementsViewController). A crafted message could drive unintended executeCommand/agent actions.", "mitigation": "Add explicit schema validation + allow-list on inbound message command and payload; reject unknown shapes. Keep executeCommand targets to a fixed, non-parameterized set.", "modelType": "STRIDE", "number": 3 }
              ]
            }
